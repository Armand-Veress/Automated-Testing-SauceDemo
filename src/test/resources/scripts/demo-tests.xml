<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo DemoTests" verbose="1" parallel="tests" thread-count="2">

    <test name="Firefox DemoTests" parallel="methods" thread-count="2">
        <parameter name="browser" value="firefox"/>
        <parameter name="driverPath" value="drivers/geckodriver.exe"/>
        <classes>
            <class name="tests.DemoTest"/>
        </classes>
    </test>

    <test name="Chrome DemoTests" parallel="methods" thread-count="2">
        <parameter name="browser" value="chrome"/>
        <parameter name="driverPath" value="drivers/chromedriver.exe"/>
        <classes>
            <class name="tests.DemoTest"/>
        </classes>
    </test>

