<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo AuthTests" verbose="1" parallel="tests" thread-count="2">

    <test name="Firefox AuthTests" parallel="methods" thread-count="2">
        <parameter name="browser" value="firefox"/>
        <parameter name="driverPath" value="drivers/geckodriver.exe"/>
        <classes>
            <class name="tests.auth.AccessControlTest"/>
            <class name="tests.auth.LoginTest"/>
            <class name="tests.auth.LogoutTest"/>
        </classes>
    </test>

    <test name="Chrome AuthTests" parallel="methods" thread-count="2">
        <parameter name="browser" value="chrome"/>
        <parameter name="driverPath" value="drivers/chromedriver.exe"/>
        <classes>
            <class name="tests.auth.AccessControlTest"/>
            <class name="tests.auth.LoginTest"/>
            <class name="tests.auth.LogoutTest"/>
        </classes>
    </test>

</suite>