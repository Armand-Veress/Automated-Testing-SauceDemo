<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo FunctionalTests" verbose="1" parallel="tests" thread-count="2">

    <test name="Firefox FunctionalTests" parallel="methods" thread-count="2">
        <parameter name="browser" value="firefox"/>
        <parameter name="driverPath" value="drivers/geckodriver.exe"/>
        <classes>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>

    <test name="Chrome FunctionalTests" parallel="methods" thread-count="2">
        <parameter name="browser" value="chrome"/>
        <parameter name="driverPath" value="drivers/chromedriver.exe"/>
        <classes>
            <class name="tests.InventoryTest"/>
        </classes>
    </test>

</suite>